{
  "name": "packpanel-backend",
  "version": "1.0.0",
  "description": "PackPanel API & Worker",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "ts-node src/api/server.ts",
    "dev:worker": "ts-node src/worker.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^7.0.4",
    "@tus/file-store": "^1.5.0",
    "@tus/server": "^1.8.0",
    "argon2": "^0.40.3",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "yauzl": "^3.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "@types/yauzl": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}

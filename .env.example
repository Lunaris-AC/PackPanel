# PackPanel Configuration

# Host & Ports
SSH_HOST=192.168.1.171
SSH_PORT=22
SSH_USER=root
ADMIN_ORIGIN_PORT=8080
FILES_ORIGIN_PORT=8081

# Domains (Replace with your actual internal or public FQDNs configured in Zoraxy / DNS)
ADMIN_FQDN=panel.mccdn.internal
FILES_FQDN=mccdn.internal
ZORAXY_SOURCE_IP=192.168.1.173

# Application & Storage Directories
APP_DIR=/opt/packpanel
DATA_DIR=/srv/packpanel

# Initial Administrator Credentials
ADMIN_LOGIN=admin
ADMIN_DEFAULT_PASSWORD=

# Security
SESSION_SECRET=change_this_to_a_secure_random_string_with_at_least_32_characters

# Database
POSTGRES_DB=packpanel
POSTGRES_USER=packpanel
POSTGRES_PASSWORD=replace_with_strong_database_password

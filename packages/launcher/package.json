{
  "name": "@packpanel/launcher",
  "version": "2.0.0",
  "description": "PackPanel standalone Electron desktop launcher",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node ../../scripts/copy-launcher-renderer.cjs",
    "build": "npm run build:main && node ../../scripts/copy-launcher-renderer.cjs",
    "test": "vitest run",
    "start": "electron dist/main/index.js"
  },
  "dependencies": {
    "@packpanel/engine": "^2.0.0",
    "@packpanel/protocol": "^2.0.0",
    "@packpanel/templates": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.5.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3"
  }
}
